{
  "name": "@trivoallan/ontrack-governance",
  "version": "0.3.0",
  "description": "Tristan Rivoallan's governance: ADRs shared as an ontrack source.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivoallan/governance.git"
  },
  "type": "module",
  "files": [
    "adr/",
    "dist/governance-check.js"
  ],
  "bin": {
    "governance-check": "dist/governance-check.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "hooks": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "prepare": "npm run build && npm run hooks",
    "test": "tsc --noEmit && node --test checks/*.test.ts"
  },
  "ontrack": {
    "adr": "adr",
    "namespace": "trivoallan"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "22.20.5",
    "ontrack": "github:trivoallan/ontrack#v0.2.0",
    "trivoallan": "github:trivoallan/governance",
    "typescript": "7.0.2"
  }
}
