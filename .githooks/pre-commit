#!/bin/sh
# ADR-0015 (secrets.guard: gitleaks): refuse a commit whose staged changes
# carry a secret. `npm install` installs it (package.json "hooks", run by
# "prepare", sets core.hooksPath to .githooks). Fails closed: without
# gitleaks, no commit. A refusal means removing the secret, and revoking it
# if it was pushed; never `git commit --no-verify`.
#
# ADR-0025 (tools.manager: mise): the gitleaks that runs is the one mise.toml
# and mise.lock pin, never one found on the PATH. `mise which` names its
# binary, and fails when the pinned version is not installed or the
# repository's mise.toml is not trusted.
root=$(dirname "$0")/..
if ! command -v mise >/dev/null 2>&1; then
  echo "pre-commit: mise is not installed, so the ADR-0015 secret guard cannot run." >&2
  echo "Install mise (https://mise.jdx.dev/installing-mise.html), run \`mise trust && mise install --locked\` in this repository, then commit again." >&2
  exit 1
fi
if ! gitleaks=$(mise -C "$root" which gitleaks); then
  echo "pre-commit: the gitleaks pinned in mise.toml is not installed, so the ADR-0015 secret guard cannot run." >&2
  echo "Run \`mise trust && mise install --locked\` in this repository, then commit again." >&2
  exit 1
fi
exec "$gitleaks" git --pre-commit --staged --redact
